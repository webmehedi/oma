{
  "$description": "Ledgerly design tokens — single source. mockups/tokens.css is generated from this file; the production Tailwind theme must be generated from it too. Contrast pairs documented in design-system.md all meet WCAG AA 4.5:1.",
  "color": {
    "light": {
      "bg": "#F6F5F1",
      "surface": "#FFFFFF",
      "surfaceSunken": "#EFEDE7",
      "border": "#E3E1D9",
      "borderStrong": "#C9C6BA",
      "text": "#1C1B17",
      "textMuted": "#5C594F",
      "accent": "#1F6F54",
      "accentHover": "#16543F",
      "onAccent": "#FFFFFF",
      "accentSoft": "#E2F0E9",
      "accentSoftText": "#14503B",
      "warnSoft": "#F9EDD4",
      "warnText": "#74510A",
      "danger": "#B3261E",
      "dangerHover": "#931D17",
      "onDanger": "#FFFFFF",
      "dangerSoft": "#FAE6E4",
      "dangerSoftText": "#8C1D16",
      "focus": "#1F6F54"
    },
    "dark": {
      "bg": "#131511",
      "surface": "#1B1E1A",
      "surfaceSunken": "#161814",
      "border": "#31362E",
      "borderStrong": "#4A5044",
      "text": "#EDECE4",
      "textMuted": "#A8A89B",
      "accent": "#55C495",
      "accentHover": "#74D2AB",
      "onAccent": "#0C271C",
      "accentSoft": "#1B3A2D",
      "accentSoftText": "#8CDDB9",
      "warnSoft": "#3A2D11",
      "warnText": "#E9BC66",
      "danger": "#E5766B",
      "dangerHover": "#EC9088",
      "onDanger": "#2B0B08",
      "dangerSoft": "#3B201C",
      "dangerSoftText": "#F2A79E",
      "focus": "#55C495"
    }
  },
  "font": {
    "family": {
      "sans": "ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
      "mono": "ui-monospace, 'SF Mono', SFMono-Regular, Menlo, Consolas, 'Liberation Mono', monospace"
    },
    "scale": {
      "display": { "size": "32px", "lineHeight": "40px", "weight": 650, "tracking": "-0.01em" },
      "title":   { "size": "24px", "lineHeight": "32px", "weight": 650, "tracking": "-0.01em" },
      "heading": { "size": "18px", "lineHeight": "26px", "weight": 600, "tracking": "0" },
      "body":    { "size": "15px", "lineHeight": "22px", "weight": 400, "tracking": "0" },
      "small":   { "size": "13px", "lineHeight": "18px", "weight": 400, "tracking": "0" },
      "micro":   { "size": "12px", "lineHeight": "16px", "weight": 550, "tracking": "0.06em", "transform": "uppercase" }
    }
  },
  "space": {
    "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "20px",
    "6": "24px", "8": "32px", "10": "40px", "12": "48px", "16": "64px"
  },
  "size": {
    "contentMax": "1120px",
    "invoiceDocMax": "720px",
    "controlHeight": "40px"
  },
  "radius": {
    "sm": "6px", "md": "10px", "lg": "14px", "full": "999px"
  },
  "shadow": {
    "light": {
      "sm": "0 1px 2px rgba(28, 27, 23, 0.06)",
      "md": "0 2px 8px rgba(28, 27, 23, 0.08)",
      "lg": "0 8px 24px rgba(28, 27, 23, 0.14)"
    },
    "dark": {
      "sm": "0 1px 2px rgba(0, 0, 0, 0.4)",
      "md": "0 2px 8px rgba(0, 0, 0, 0.45)",
      "lg": "0 8px 24px rgba(0, 0, 0, 0.55)"
    }
  },
  "breakpoints": {
    "sm": "640px", "md": "768px", "lg": "1024px", "xl": "1280px"
  },
  "motion": {
    "$note": "Mirror of motion-spec.md (the authority). Durations ms, easings CSS cubic-bezier.",
    "duration": {
      "enterFast": "180ms", "enterDefault": "320ms",
      "exitFast": "120ms", "exitDefault": "200ms",
      "moveDefault": "260ms", "emphasis": "400ms"
    },
    "easing": {
      "enter": "cubic-bezier(0.2, 0, 0, 1)",
      "exit": "cubic-bezier(0.4, 0, 1, 1)",
      "move": "cubic-bezier(0.4, 0, 0.2, 1)",
      "emphasis": "spring(1, 80, 12)"
    },
    "stagger": { "list": "40ms", "hero": "90ms" },
    "scroll": { "lerp": 0.1, "revealOffset": "15%", "revealDistance": "24px" }
  }
}
